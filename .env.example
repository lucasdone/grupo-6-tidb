# ============================================================
# FerryFlow – Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# Amazon Bedrock – Singapore (ap-southeast-1)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=ap-southeast-1

# TiDB Cloud Starter – AWS São Paulo
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=airportdb

# Optional: TiDB SSL CA certificate path
# Leave blank to use the bundled DigiCert CA
TIDB_SSL_CA=
